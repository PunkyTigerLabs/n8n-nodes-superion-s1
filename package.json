{
	"name": "n8n-nodes-superion-s1",
	"version": "0.1.0",
	"description": "n8n community node for Superion S1 by Punky Tiger Labs: calibrated yes/no, choice and score decisions about any text in one API call.",
	"license": "MIT",
	"homepage": "https://punkytigerlabs.com/s1/",
	"keywords": [
		"n8n-community-node-package",
		"superion",
		"classification",
		"moderation",
		"guardrail",
		"calibrated"
	],
	"author": {
		"name": "Punky Tiger Labs",
		"email": "alvaro.lopez@punkytigerlabs.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PunkyTigerLabs/n8n-nodes-superion-s1.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SuperionS1Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/SuperionS1/SuperionS1.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
